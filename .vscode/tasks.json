{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: preparar pasta bin",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "C: compilar arquivo atual",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-lm"
            ],
            "group": {
                "kind": "build",
            },
            "dependsOn": "C: preparar pasta bin",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "C: compilar e executar",
            "type": "shell",
            "command": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
            "dependsOn": "C: compilar arquivo atual",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
